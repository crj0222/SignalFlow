DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Optional: speeds up slash command sync while testing in one server.
GUILD_ID=123456789012345678

# Optional: defaults to signalflow.sqlite3
DATABASE_PATH=signalflow.sqlite3

# Comma-separated Discord user IDs that can enable/disable servers.
OWNER_IDS=123456789012345678

# Optional: comma-separated Discord user IDs that should automatically mark
# every routed entry alert as taken for tracking only. This does not place trades.
AUTO_TAKE_USER_IDS=

# Optional: enables AI alert classification for varied analyst wording.
OPENAI_API_KEY=
# Recommended GPT-5-family classifier model. Use the exact slug with hyphens.
OPENAI_CLASSIFIER_MODEL=gpt-5-mini
USE_AI_CLASSIFIER=true
USE_IMAGE_CLASSIFIER=true
OPENAI_CLASSIFIER_TIMEOUT_SECONDS=8

# Optional local/web dashboard settings.
# Railway provides PORT automatically and SignalFlow will bind to 0.0.0.0 there.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
ENABLE_WEB_DASHBOARD=false
DASHBOARD_TOKEN=
PUBLIC_DASHBOARD_URL=http://127.0.0.1:8080
DASHBOARD_SESSION_SECRET=change_this_to_a_long_random_string

# Optional: enables Discord OAuth login for the web dashboard.
# Redirect URI must exactly match the URL added in the Discord Developer Portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/oauth/callback
